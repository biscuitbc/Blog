---
import { site } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="site-footer shell">
  <span>© {year} {site.author}</span>
  <nav aria-label="页脚导航">
    <a href="/">首页</a>
    <a href="/about/">关于</a>
    <a href="/posts/">归档</a>
    <a href="/tags/">标签</a>
    <a href="/rss.xml">RSS</a>
  </nav>
</footer>

<style>
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 6rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.75rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  nav a {
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .site-footer {
      align-items: flex-start;
      flex-direction: column;
      margin-top: 4rem;
    }
  }
</style>
