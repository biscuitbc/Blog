---
import { site } from "../config/site";

const pathname = Astro.url.pathname;
const nav = [
  { href: "/", label: "首页" },
  { href: "/about/", label: "关于" },
  { href: "/posts/", label: "归档" },
  { href: "/tags/", label: "标签" },
];
---

<header class="site-header shell">
  <a class="site-title" href="/">{site.title}</a>
  <nav aria-label="主导航">
    {
      nav.map((item) => (
        <a
          class:list={{ active: item.href === "/" ? pathname === "/" : pathname.startsWith(item.href) }}
          href={item.href}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .site-title {
    color: var(--text-strong);
    font-size: 1.7rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0;
    margin-top: 0.15rem;
  }

  nav a {
    color: var(--accent);
    font-size: 0.86rem;
    text-decoration: none;
  }

  nav a:not(:last-child)::after {
    margin: 0 0.65rem;
    color: var(--muted);
    content: "|";
  }

  nav a.active {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .site-header {
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }

    .site-title {
      font-size: 1.4rem;
    }
  }
</style>
