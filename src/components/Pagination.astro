---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;
const pages = Array.from({ length: totalPages }, (_, index) => index + 1);
const pageUrl = (page: number) => page === 1 ? "/posts/" : `/posts/page/${page}/`;
---

<nav class="pagination" aria-label="归档分页">
  {
    currentPage > 1
      ? <a class="step" href={pageUrl(currentPage - 1)}>← 上一页</a>
      : <span class="step disabled" aria-disabled="true">← 上一页</span>
  }

  <div class="page-numbers">
    {
      pages.map((page) => (
        page === currentPage
          ? <span class="current" aria-current="page">{page}</span>
          : <a href={pageUrl(page)}>{page}</a>
      ))
    }
  </div>

  {
    currentPage < totalPages
      ? <a class="step" href={pageUrl(currentPage + 1)}>下一页 →</a>
      : <span class="step disabled" aria-disabled="true">下一页 →</span>
  }
</nav>

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .step:last-child {
    text-align: right;
  }

  .disabled {
    color: var(--line);
    cursor: default;
  }

  .page-numbers {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .page-numbers a,
  .page-numbers span {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
  }

  .page-numbers a {
    color: var(--muted);
  }

  .page-numbers a:hover {
    color: var(--accent);
  }

  .page-numbers .current {
    background: var(--accent);
    color: var(--background);
  }

  @media (max-width: 480px) {
    .pagination {
      grid-template-columns: auto 1fr auto;
      font-size: 0.65rem;
    }

    .page-numbers {
      justify-content: center;
    }
  }
</style>
