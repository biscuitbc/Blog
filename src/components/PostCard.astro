---
import type { Post } from "../utils/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const href = `/posts/${post.id.replace(/\.(md|mdx)$/, "")}/`;
const date = post.data.publishedAt.toISOString().slice(0, 10);
---

<article class="post-row">
  <time datetime={post.data.publishedAt.toISOString()}>{date}</time>
  <div>
    <h2><a href={href}>{post.data.title}</a></h2>
  </div>
</article>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 108px minmax(0, 1fr);
    gap: 0.5rem;
    margin-bottom: 1.15rem;
  }

  time {
    padding-top: 0.08rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  h2 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.6;
  }

  h2 a {
    color: var(--text);
  }

  h2 a:hover {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: 1.4rem;
    }

    time {
      font-size: 0.72rem;
    }
  }
</style>
