---
import type { Post } from "../utils/posts";

interface Props {
  post: Post;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const href = `/posts/${post.id.replace(/\.(md|mdx)$/, "")}/`;
const date = post.data.publishedAt.toISOString().slice(0, 10);
---

<article class="post-row">
  <span class="post-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
  <div class="post-copy">
    <h2><a href={href}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
  </div>
  <time datetime={post.data.publishedAt.toISOString()}>{date}</time>
</article>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    padding: 1.35rem 0;
    border-top: 1px solid var(--line);
  }

  .post-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .post-index {
    padding-top: 0.18rem;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.66rem;
  }

  h2 {
    margin: 0;
    color: var(--text-strong);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  h2 a:hover {
    color: var(--accent);
  }

  p {
    max-width: 590px;
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  time {
    padding-top: 0.18rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .post-row {
      grid-template-columns: 30px minmax(0, 1fr);
      gap: 0.65rem;
    }

    time {
      grid-column: 2;
      grid-row: 2;
      padding-top: 0;
    }
  }
</style>
