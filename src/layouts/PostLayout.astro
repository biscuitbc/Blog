---
import type { Post } from "../utils/posts";
import { render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { tagSlug } from "../utils/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = post.data.publishedAt.toISOString().slice(0, 10);
const updated = post.data.updatedAt?.toISOString().slice(0, 10);
---

<BaseLayout title={post.data.title} description={post.data.description} article>
  <article>
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <p class="article-date">
        发布于 {published}
        {updated && updated !== published ? ` · 更新于 ${updated}` : ""}
      </p>
      {post.data.tags.length > 0 && (
        <p class="article-tags">
          {post.data.tags.map((tag) => <a href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>)}
        </p>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <p class="back"><a href="/posts/">← 返回归档</a></p>
  </article>
</BaseLayout>

<style>
  .article-header {
    margin-bottom: 3rem;
  }

  h1 {
    margin: 0 0 0.75rem;
    color: var(--text-strong);
    font-size: clamp(1.55rem, 5vw, 2rem);
    line-height: 1.45;
  }

  .article-date,
  .article-tags {
    margin: 0.2rem 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .article-tags a {
    margin-right: 0.6rem;
    color: var(--accent);
  }

  .back {
    margin-top: 4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
  }
</style>
