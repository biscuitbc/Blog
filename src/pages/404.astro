---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在" description="你访问的页面不存在。">
  <section class="not-found shell">
    <p class="code">404</p>
    <p class="eyebrow">PAGE NOT FOUND</p>
    <h1>这一页还没有被写下。</h1>
    <p>也可能它曾经存在，只是后来换了一个位置。</p>
    <a href="/">回到首页 <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 65vh;
    padding: 7rem 0;
  }

  .code {
    margin: 0;
    color: var(--line);
    font-family: var(--serif);
    font-size: clamp(8rem, 28vw, 22rem);
    font-weight: 700;
    letter-spacing: -0.09em;
    line-height: 0.75;
  }

  h1 {
    margin: 1rem 0;
    font-family: var(--serif);
    font-size: clamp(2rem, 5vw, 3.6rem);
  }

  .not-found > p:not(.code, .eyebrow) {
    color: var(--muted);
    font-family: var(--serif);
  }

  .not-found > a {
    display: inline-block;
    margin-top: 1.5rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--ink);
  }
</style>
