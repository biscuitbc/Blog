---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404" description="页面不存在。">
  <section class="not-found">
    <h1>404</h1>
    <p>页面不存在。</p>
    <p><a href="/">← 返回首页</a></p>
  </section>
</BaseLayout>

<style>
  .not-found h1 {
    margin: 0;
    color: var(--accent);
    font-size: 2rem;
  }

  .not-found p {
    color: var(--muted);
  }
</style>
