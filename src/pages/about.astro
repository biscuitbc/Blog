---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---

<BaseLayout title="关于" description={`关于 ${site.title}。`}>
  <header class="page-intro">
    <h1>关于</h1>
  </header>
  <div class="prose">
    <p>你好，我是 biscuitbc。</p>
    <p>这里用来记录正在学习、构建和思考的事情，内容可能包括代码、研究、工具与日常观察。</p>
    <p>
      你可以访问<a href={site.mainSite} target="_blank" rel="noreferrer">我的个人主页</a>，
      或在 <a href={site.github} target="_blank" rel="noreferrer">GitHub</a> 查看公开项目。
    </p>
    <p><a href="/rss.xml">订阅 RSS</a></p>
  </div>
</BaseLayout>
