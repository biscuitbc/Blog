---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { isPublished, sortPosts, tagSlug } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter(isPublished);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: {
      tag,
      posts: sortPosts(posts.filter((post) => post.data.tags.includes(tag))),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`Biscuit Blog 中关于“${tag}”的文章。`}>
  <header class="page-intro shell">
    <p class="eyebrow">TOPIC · {String(posts.length).padStart(2, "0")} POSTS</p>
    <h1 class="display-title">{tag}</h1>
    <p>这个关键词下的全部文章。</p>
  </header>
  <section class="post-list shell">
    {posts.map((post, index) => <PostCard post={post} index={index} />)}
  </section>
</BaseLayout>

<style>
  .post-list {
    padding-top: 3rem;
  }
</style>
