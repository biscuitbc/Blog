---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublished, tagSlug } from "../../utils/posts";

const posts = (await getCollection("posts")).filter(isPublished);
const counts = posts.reduce<Record<string, number>>((result, post) => {
  for (const tag of post.data.tags) result[tag] = (result[tag] ?? 0) + 1;
  return result;
}, {});
const tags = Object.entries(counts).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "zh-CN"));
---

<BaseLayout title="标签" description="文章标签。">
  <header class="page-intro">
    <h1>标签</h1>
    <p>共 {tags.length} 个标签</p>
  </header>
  <ul class="tag-list">
    {tags.map(([tag, count]) => (
      <li>
        <a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
        <span>{count}</span>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .tag-list {
    max-width: 420px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px dotted var(--line);
  }

  .tag-list a {
    color: var(--accent);
  }

  .tag-list span {
    color: var(--muted);
  }
</style>
